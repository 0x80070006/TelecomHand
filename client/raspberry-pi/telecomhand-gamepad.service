[Unit]
Description=TelecomHand DualShock 4 remote
After=bluetooth.target display-manager.service

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=input
WorkingDirectory=__HOME__/.local/share/telecomhand
ExecStart=/usr/bin/python3 __HOME__/.local/share/telecomhand/telecomhand_gamepad.py
Restart=always
RestartSec=3
# Une configuration invalide ne se corrigera pas toute seule : voir EXIT_BAD_CONFIG.
RestartPreventExitStatus=2
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus

[Install]
WantedBy=multi-user.target
